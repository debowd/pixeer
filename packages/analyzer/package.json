{
  "name": "@pixeer/analyzer",
  "version": "0.0.1",
  "description": "Build-time static analyzer for Pixeer — reads your route components and generates PixeerAppContext via LLM-assisted source analysis",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.mjs",
      "require": "./dist/vite-plugin.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pixeer-analyze": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "dev": "tsdown --watch --config tsdown.config.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "pixeer": ">=0.0.1",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^3.0.0",
    "pixeer": "workspace:*",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "keywords": ["pixeer", "analyzer", "codegen", "vite-plugin", "ai-agent", "react", "accessibility"]
}
