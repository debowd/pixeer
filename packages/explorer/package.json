{
  "name": "@pixeer/explorer",
  "version": "0.0.1",
  "description": "BFS exploration engine for Pixeer — explore interactive elements offline and generate PixeerAppContext for production agents",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "dev": "tsdown --watch --config tsdown.config.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "pixeer": ">=0.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^3.0.0",
    "happy-dom": "^18.0.1",
    "pixeer": "workspace:*",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "pixeer",
    "explorer",
    "bfs",
    "dom",
    "ai-agent",
    "app-context",
    "accessibility"
  ]
}
